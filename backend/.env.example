# ===================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ===================================
# Copy this file to .env and fill with your actual values
# NEVER commit .env to git (it contains secrets)

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
NODE_ENV=production

# ===================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ===================================
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME
# Get from: https://cloud.mongodb.com
# 1. Create cluster
# 2. Add database user (username/password)
# 3. Click "Connect" and copy connection string
# 4. Replace <username>, <password>, <cluster>, <database>
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/safespeak-plus?retryWrites=true&w=majority

# ===================================
# JWT CONFIGURATION (JSON Web Tokens)
# ===================================
# Generate strong secret: https://www.uuidgenerator.net/ (copy 2-3 UUIDs)
# Or use: openssl rand -base64 32
# MUST be at least 32 characters
JWT_SECRET=YOUR_STRONG_32_CHARACTER_SECRET_KEY_HERE_REPLACE_ME
JWT_EXPIRE=7d

# ===================================
# CORS & DEPLOYMENT CONFIGURATION
# ===================================
# FRONTEND_URL: Your Vercel deployment URL
# Example: https://safespeak-plus.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# ADDITIONAL_FRONTEND_ORIGINS: Comma-separated list for preview/test URLs
# Example: https://preview.vercel.app, https://test.vercel.app
ADDITIONAL_FRONTEND_ORIGINS=

# ===================================
# EMAIL CONFIGURATION (Gmail with App Password)
# ===================================
# Get Gmail App Password:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer" (or Your Device)
# 3. Google generates 16 character password
# 4. Copy and paste below (without spaces)

SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ===================================
# APPLICATION METADATA
# ===================================
APP_NAME=SafeSpeak-Plus
APP_VERSION=1.0.0

# ===================================
# SECURITY CONFIGURATION
# ===================================
# Number of password encryption rounds
# 10 = Good balance (2^10 = 1024 iterations)
BCRYPT_ROUNDS=10
