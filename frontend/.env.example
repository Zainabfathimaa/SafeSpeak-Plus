# ===================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# ===================================
# Copy this file to .env.local and fill with your actual values
# NEVER commit .env files to git (they contain secrets)

# ===================================
# API CONFIGURATION
# ===================================
# VITE_BACKEND_URL: Your Render backend API URL
# Development: http://localhost:5000/api
# Production (Render): https://safespeak-plus-api.onrender.com/api
# Do NOT include trailing slash
VITE_BACKEND_URL=https://safespeak-plus-api.onrender.com/api

# ===================================
# ENVIRONMENT
# ===================================
# VITE_ENVIRONMENT: Identifies which environment
# Values: development, staging, production
VITE_ENVIRONMENT=production
